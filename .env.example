# App settings
APP_ENV=local
APP_READ_ONLY_MODE=true
ALLOW_WRITE_SQL=false
MAX_RESULT_ROWS=1000

# Databricks connection
# Real values go in .env only.
DATABRICKS_SERVER_HOSTNAME=your-databricks-server-hostname
DATABRICKS_HTTP_PATH=your-databricks-sql-warehouse-http-path
DATABRICKS_ACCESS_TOKEN=your-databricks-access-token

# Databricks table names
DATABRICKS_P2C_TABLE=cdp_uat.dsag_new.p2c
DATABRICKS_MAB_MEB_TABLE=cdp_uat.dsag_new.mab_meb

# LLM provider
LLM_PROVIDER=groq
LLM_API_KEY=your-llm-api-key
LLM_MODEL=llama-3.1-8b-instant

# ChromaDB settings
CHROMA_DB_DIR=.chroma
CHROMA_COLLECTION_NAME=conversational_analytics_knowledge